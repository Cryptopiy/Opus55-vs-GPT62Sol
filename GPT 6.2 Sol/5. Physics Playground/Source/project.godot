; Contraption Lab
config_version=5

[application]

config/name="Contraption Lab"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=16
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
jolt_physics_3d/simulation/velocity_steps=22
jolt_physics_3d/simulation/position_steps=8

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="d3d12"
lights_and_shadows/directional_shadow/size=2048
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/use_nearest_mipmap_filter=false
