; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Physics Playground"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Save="*res://scripts/core/save_data.gd"
Sfx="*res://scripts/audio/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"
3d/default_gravity=9.81
3d/default_linear_damp=0.02
3d/default_angular_damp=0.05
jolt_physics_3d/simulation/velocity_steps=32
jolt_physics_3d/simulation/position_steps=12

[rendering]

rendering_device/driver.windows="d3d12"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
